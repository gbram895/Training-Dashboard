generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  name         String
  createdAt    DateTime            @default(now())
  workouts     Workout[]
  goals        Goal[]
  healthDays   DailyHealthSummary[]
  healthSync   HealthSyncConfig?
  syncedFiles  SyncedDropboxFile[]

  // Heart-rate zone thresholds (bpm) — upper bound of zones 1-4; zone 5 is everything above z4Max
  hrZone1Max   Int                 @default(114)
  hrZone2Max   Int                 @default(133)
  hrZone3Max   Int                 @default(152)
  hrZone4Max   Int                 @default(171)
}

enum WorkoutType {
  RUN
  RIDE
  STRENGTH
  SWIM
  WALK
  BADMINTON
  OTHER
}

model Workout {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        WorkoutType
  date        DateTime
  durationMin Int
  distanceKm  Float?
  notes       String?
  source      String          @default("manual")
  externalId  String?         @unique
  createdAt   DateTime        @default(now())
  exercises   ExerciseEntry[]

  // Minutes spent in each heart-rate zone, computed at import time from raw
  // per-workout HR samples (Apple Health only) using the user's zone thresholds
  hrZone1Min  Float?
  hrZone2Min  Float?
  hrZone3Min  Float?
  hrZone4Min  Float?
  hrZone5Min  Float?

  @@index([userId, date])
}

model ExerciseEntry {
  id        String  @id @default(uuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Int
  reps      Int
  weightKg  Float?
  order     Int     @default(0)
}

model DailyHealthSummary {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  steps             Int?
  distanceKm        Float?
  activeEnergyKcal  Float?
  avgHeartRate      Float?
  restingHeartRate  Float?
  sleepHours        Float?
  exerciseMinutes   Float?
  flightsClimbed    Int?
  vo2Max            Float?
  avgHrv            Float?
  avgBloodOxygen    Float?
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
}

model HealthSyncConfig {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dropboxRefreshToken String
  folderPaths         String[]  @default(["/Apps/Health Auto Export/Health Auto Export/Apple health", "/Apps/Health Auto Export/Health Auto Export/Apple Health Wourkouts"])
  lastSyncedAt        DateTime?
  lastSyncError       String?
  createdAt           DateTime  @default(now())
}

model SyncedDropboxFile {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path           String
  serverModified DateTime
  syncedAt       DateTime @default(now())

  @@unique([userId, path])
}

model Goal {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  targetValue Float
  currentValue Float    @default(0)
  unit        String
  deadline    DateTime?
  createdAt   DateTime  @default(now())
}
